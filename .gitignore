# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env — public repo, so ignore every variant and document the names instead
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local tooling state — CLAUDE.md and .claude/settings.json stay committed
.claude/settings.local.json

# editors and OS
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
Thumbs.db

# 3D asset authoring sources — heavy and not needed to build.
# The optimised .glb/.gltf and their textures ARE committed: the asset library is one of the
# three things docs/roadmap.md says compounds, and the perf budget in docs/architecture.md
# (~100–150k triangles) is the size discipline. Do not move these to Git LFS — it complicates
# Vercel builds and undermines the offline static export on the exhibition machine.
*.blend
*.blend[0-9]
*.fbx
*.max
*.psd
*.substance

# HDX COD-AB source archives — 175–437 MB each, and we need one polygon out of one
# of them. scripts/extract-boundary.py pulls that polygon into
# src/scenes/wat-ket.boundary.geojson, which IS committed. The archive is not:
# nothing at build or run time reads it, and it is a one-command download.
/data/hdx/

# Python bytecode from the one-off distillation scripts.
__pycache__/
*.pyc

# GHS-POP population tiles — the source for the REGION register's height field.
# ~50 tiles at ~5 MB each. scripts/build-region.py distils them to one committed
# PNG plus a sidecar; nothing at build or run time reads the tiles themselves.
/data/ghsl/

# GeoNames city dump — the source for the REGION register's labels.
# build-region.py distils it to one committed JSON; nothing reads the dump at
# build or run time.
/data/geonames/

# Satellite-derived building caches — the Overture parquet, the 2.5D height raster
# window and the merged buildings JSON that scripts/fetch-buildings.py writes.
# Regenerable, ~100 MB, and read only by scripts/fetch-osm.ts, which folds them
# into the committed scene document. Same rule as the Overpass cache below.
/data/buildings-cache/

# Copernicus DEM window — the source for the relief backdrop. scripts/fetch-relief.py
# distils it to one committed PNG plus a sidecar; nothing reads the window itself.
/data/relief-cache/

# Raw Overpass / OSM responses — regenerable and large.
# The GENERATED scene document is committed: the exhibition must not depend on Overpass
# being up (docs/architecture.md), and the editor's output is committed too (roadmap item 4).
/data/osm-cache/
*.overpass.json

# Local-only working notes — people, private doc links, internal programme
# assessments. Never commit: this repo is public.
/.local/
docs/programme-context.md

# Visual reference material — photographs of third-party artefacts, often carrying
# camera EXIF including GPS. Local only. Derived palettes live in docs/design-system.md.
/docs/references/

# Riverbanks studio material (talk notes; names people, local only)
riverbanks/

# scripts/build-cells.py scratch: the ndjson and mbtiles tippecanoe works from.
data/cells-build/

# MapLibre worker, copied from node_modules on postinstall — see scripts/copy-maplibre-worker.sh.
public/maplibre/

# Icon generation scratch: probe, candidates and the KV refs copied in. Chosen icons go to public/icons/.
data/icons/
